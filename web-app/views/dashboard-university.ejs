<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>University Dashboard</title>
    <base href="/">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.0/css/bootstrap.min.css" integrity="sha384-9gVQ4dYFwwWSjIDZnLEWnxCjeSWFphJiwGPXr1jddIhOegiu1FwO5qRGvFXOdJZ4" crossorigin="anonymous">
    <link rel="stylesheet" href="stylesheets/style.css">
</head>
<body class="bg-light rainbow-page">
<%- include('partials/navbar-partial.ejs') %>

<div class="container py-4">
    <div class="card mb-4">
        <div class="card-body">
            <h4 class="mb-3">Issued Certificates Explorer</h4>
            <p class="text-muted mb-3">Click Department, then Course, then Student to open the certificate record.</p>
            <div class="mb-2"><strong>Departments</strong></div>
            <div id="department-list" class="mb-3"></div>
            <div class="mb-2"><strong>Courses</strong></div>
            <div id="course-list" class="mb-3"></div>
            <div class="mb-2"><strong>Students</strong></div>
            <div id="student-list"></div>
        </div>
    </div>

    <% if (!certData || !certData.length) { %>
        <div class="alert alert-info">No certificates issued yet.</div>
    <% } %>

</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.0/umd/popper.min.js" integrity="sha384-cs/chFZiN24E4KMATLdqdvsezGxaGsi4hLGOzlXwp5UZB1LY//20VyM2taTB4QvJ" crossorigin="anonymous"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.1.0/js/bootstrap.min.js" integrity="sha384-uefMccjFJAIv6A+rW+L4AHf99KvxDjWSu1z9VI8SKNVmz4sk7buKt/6v9KI65qnm" crossorigin="anonymous"></script>
<script>
(function () {
    var data = <%- JSON.stringify(certData || []) %>;
    var deptList = document.getElementById("department-list");
    var courseList = document.getElementById("course-list");
    var studentList = document.getElementById("student-list");

    function uniq(values) {
        return Array.from(new Set(values.filter(Boolean)));
    }

    function button(label, onClick) {
        var btn = document.createElement("button");
        btn.type = "button";
        btn.className = "btn btn-sm btn-outline-primary mr-2 mb-2";
        btn.textContent = label;
        btn.addEventListener("click", onClick);
        return btn;
    }

    function renderStudents(department, course) {
        studentList.innerHTML = "";
        var matches = data.filter(function (item) {
            return (item.departmentName || "General") === department && (item.major || "General Course") === course;
        });

        if (!matches.length) {
            studentList.innerHTML = '<div class="text-muted">No students in this course.</div>';
            return;
        }

        matches.forEach(function (item) {
            var row = document.createElement("div");
            row.className = "d-flex align-items-center justify-content-between border rounded p-2 mb-2 bg-white";
            row.innerHTML =
                '<div><strong>' + (item.studentName || "-") + '</strong><br><small>' + (item.studentEmail || "-") + '</small></div>' +
                '<a class="btn btn-success btn-sm" href="/certificates/' + item.certUUID + '">Open</a>';
            studentList.appendChild(row);
        });
    }

    function renderCourses(department) {
        courseList.innerHTML = "";
        studentList.innerHTML = "";

        var courses = uniq(
            data
                .filter(function (item) { return (item.departmentName || "General") === department; })
                .map(function (item) { return item.major || "General Course"; })
        );

        if (!courses.length) {
            courseList.innerHTML = '<div class="text-muted">No courses in this department.</div>';
            return;
        }

        courses.forEach(function (course) {
            courseList.appendChild(button(course, function () {
                renderStudents(department, course);
            }));
        });
    }

    function renderDepartments() {
        deptList.innerHTML = "";
        courseList.innerHTML = "";
        studentList.innerHTML = "";

        var departments = uniq(data.map(function (item) {
            return item.departmentName || "General";
        }));

        if (!departments.length) {
            deptList.innerHTML = '<div class="text-muted">No department data available.</div>';
            return;
        }

        departments.forEach(function (department) {
            deptList.appendChild(button(department, function () {
                renderCourses(department);
            }));
        });
    }

    renderDepartments();
})();
</script>
</body>
</html>

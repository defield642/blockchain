<!doctype html>
<html>

<head>
  <meta charset="utf-8">
  <title>Blockchain Certificates</title>
  <base href="/">
  <style>
    html {
      font-size: 20px;
    }
  </style>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.0/css/bootstrap.min.css" integrity="sha384-9gVQ4dYFwwWSjIDZnLEWnxCjeSWFphJiwGPXr1jddIhOegiu1FwO5qRGvFXOdJZ4" crossorigin="anonymous">
  <link rel="stylesheet" href="stylesheets/style.css">
</head>


<body class="rainbow-page">
 <%- include('partials/navbar-partial.ejs') %>
<div class="home-strip">
  <div class="container">
    <div class="home-strip__title">Choose Your Portal</div>
    <div class="home-strip__row">
      <a class="home-tile home-tile--student" href="/student/login">
        <div class="home-tile__overlay"></div>
        <div class="home-tile__content">
          <div class="home-tile__label">Students</div>
          <div class="home-tile__desc">Login to view certificates and build your profile.</div>
        </div>
      </a>
      <a class="home-tile home-tile--university" href="/university/register">
        <div class="home-tile__overlay"></div>
        <div class="home-tile__content">
          <div class="home-tile__label">Universities</div>
          <div class="home-tile__desc">Register and issue official certificates.</div>
        </div>
      </a>
      <a class="home-tile home-tile--employer" href="/certificates">
        <div class="home-tile__overlay"></div>
        <div class="home-tile__content">
          <div class="home-tile__label">Employers</div>
          <div class="home-tile__desc">Browse issued certificates and recruit talent.</div>
        </div>
      </a>
    </div>
  </div>
</div>

<div class="home-verify">
  <div class="container">
    <div class="home-verify__card">
      <h3>Enter Address To Find Student Profile</h3>
      <p class="text-muted">Paste the proof code shared by a student to view their verified profile.</p>
      <a class="btn btn-primary btn-lg" href="/verify" role="button">Enter Address To Find Student Profile</a>
    </div>
  </div>
</div>



</body>

</html>

<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.0/umd/popper.min.js" integrity="sha384-cs/chFZiN24E4KMATLdqdvsezGxaGsi4hLGOzlXwp5UZB1LY//20VyM2taTB4QvJ" crossorigin="anonymous"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.1.0/js/bootstrap.min.js" integrity="sha384-uefMccjFJAIv6A+rW+L4AHf99KvxDjWSu1z9VI8SKNVmz4sk7buKt/6v9KI65qnm" crossorigin="anonymous"></script>

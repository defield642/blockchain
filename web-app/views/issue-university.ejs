<!doctype html>
<html>

<head>
    <meta charset="utf-8">
    <title>Blockchain Certificate</title>
    <base href="/">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.0/css/bootstrap.min.css" integrity="sha384-9gVQ4dYFwwWSjIDZnLEWnxCjeSWFphJiwGPXr1jddIhOegiu1FwO5qRGvFXOdJZ4" crossorigin="anonymous">
    <link rel="stylesheet" href="stylesheets/style.css">
</head>

<body class="bg-light issue-rainbow rainbow-page">
<%- include('partials/navbar-partial.ejs') %>

<!--// Major-->
<!--// CGPA-->
<!--// Date of Issue-->
<!--// Name of student-->
<!--// Email of student-->
<!--//-->


<div class="row justify-content-center form-all">
    <div class="col-md-6">
        <div class="card">
            <header class="card-header">
                <h4 class="card-title mt-2">Issue Certificate</h4>
            </header>
            <article class="card-body">
                <% if (typeof error !== "undefined") { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <form action="/university/issue" method="POST" enctype="multipart/form-data">
                    <div class="form-row">
                        <div class="col form-group">
                            <userName>Student Name</userName>
                            <input name="studentName" required type="text" class="form-control" placeholder="required">
                        </div> <!-- form-group end.// -->
                        <div class="col form-group">
                            <userName>Student Email</userName>
                            <input name="studentEmail" required type="text" class="form-control" placeholder="required">
                        </div> <!-- form-group end.// -->
                    </div> <!-- form-row end.// -->
                    <div class="form-row">
                        <div class="col form-group">
                            <userName>Student Registration Number</userName>
                            <input name="studentRegistrationNumber" required type="text" class="form-control" placeholder="required">
                        </div>
                        <div class="col form-group">
                            <userName>Student National Id Number</userName>
                            <input name="studentNationalIdNumber" required type="text" class="form-control" placeholder="required">
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="form-row">
                            <div class="col form-group">
                                <userName>Major</userName>
                                <input name="major" required type="text" class="form-control" placeholder="required">
                            </div> <!-- form-group end.// -->
                        </div> <!-- form-group end.// -->
                        <!-- form-group end.// -->
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <userName>Department Name</userName>
                                <input name="department" required type="text" class="form-control" placeholder="required" list="department-options">
                                <datalist id="department-options">
                                    <option value="SPAS"></option>
                                    <option value="Education"></option>
                                    <option value="Engineering"></option>
                                    <option value="Medicine"></option>
                                    <option value="Business"></option>
                                    <option value="Law"></option>
                                    <option value="Agriculture"></option>
                                    <option value="Humanities"></option>
                                    <option value="ICT"></option>
                                    <option value="Science"></option>
                                </datalist>
                            </div> <!-- form-group end.// -->
                            <div class="form-group col-md-6">
                                <userName>Date Of Issue</userName>
                                <input name="date" required type="date" class="form-control">
                            </div> <!-- form-group end.// -->
                        </div> <!-- form-row.// -->
                        <div class="form-group">
                            <userName>Transcripts (Years 1–4)</userName>
                            <div class="small text-muted mb-2">Upload at least 1 transcript</div>
                            <div class="form-row">
                                <div class="col form-group">
                                    <label class="small text-muted">Year 1</label>
                                    <input name="transcriptYear1" type="file" class="form-control-file transcript-input">
                                </div>
                                <div class="col form-group">
                                    <label class="small text-muted">Year 2</label>
                                    <input name="transcriptYear2" type="file" class="form-control-file transcript-input">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="col form-group">
                                    <label class="small text-muted">Year 3</label>
                                    <input name="transcriptYear3" type="file" class="form-control-file transcript-input">
                                </div>
                                <div class="col form-group">
                                    <label class="small text-muted">Year 4</label>
                                    <input name="transcriptYear4" type="file" class="form-control-file transcript-input">
                                </div>
                            </div>
                            <div class="mt-2 small text-muted" id="transcript-preview">no transcripts selected yet</div>
                        </div>
                        <div class="form-group">
                            <input type="hidden" name="confirmTranscripts" id="confirm-transcripts" value="">
                            <button type="button" class="btn btn-outline-success btn-sm" id="confirm-transcripts-btn">Confirm Files Before Upload</button>
                            <div class="small text-muted mt-1">Review selected files, then confirm to enable issuing.</div>
                        </div>
                        <div class="form-group">
                            <a href="#" class="text-success" id="additional-info-toggle">Additional Informations (Optional)</a>
                            <div class="mt-3 d-none" id="additional-info-section">
                                <div class="form-group">
                                    <label class="small text-muted">Missing marks, failed units, supplementary units, or extra notes</label>
                                    <textarea name="additionalInfoNotes" class="form-control" rows="3" placeholder="optional details"></textarea>
                                </div>
                                <div class="form-group">
                                    <label class="small text-muted">Upload supporting files (optional)</label>
                                    <input name="additionalInfoFiles" type="file" class="form-control-file" multiple>
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-block" id="issue-submit" disabled> Issue </button>
                    </div> <!-- form-group// -->
                </form>
            </article> <!-- card-body end .// -->
    </div> <!-- col.//-->

</div> <!-- row.//-->


</div>
<!--container end.//-->


</body>

</html>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.0/umd/popper.min.js" integrity="sha384-cs/chFZiN24E4KMATLdqdvsezGxaGsi4hLGOzlXwp5UZB1LY//20VyM2taTB4QvJ" crossorigin="anonymous"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.1.0/js/bootstrap.min.js" integrity="sha384-uefMccjFJAIv6A+rW+L4AHf99KvxDjWSu1z9VI8SKNVmz4sk7buKt/6v9KI65qnm" crossorigin="anonymous"></script>
<script>
  (function () {
    const toggle = document.getElementById("additional-info-toggle");
    const section = document.getElementById("additional-info-section");
    if (!toggle || !section) return;

    toggle.addEventListener("click", (event) => {
      event.preventDefault();
      section.classList.toggle("d-none");
    });
  })();
</script>
<script>
  (function () {
    const inputs = Array.from(document.querySelectorAll(".transcript-input"));
    const preview = document.getElementById("transcript-preview");
    const confirmBtn = document.getElementById("confirm-transcripts-btn");
    const confirmField = document.getElementById("confirm-transcripts");
    const submitBtn = document.getElementById("issue-submit");

    if (!inputs.length || !preview || !confirmBtn || !confirmField || !submitBtn) {
      return;
    }

    const renderPreview = () => {
      const files = inputs.flatMap((input) => Array.from(input.files || []));
      if (files.length === 0) {
        preview.textContent = "no transcripts selected yet";
      } else {
        preview.textContent = files.map((file) => file.name).join(", ");
      }
      confirmField.value = "";
      submitBtn.disabled = true;
    };

    inputs.forEach((input) => {
      input.addEventListener("change", renderPreview);
    });

    confirmBtn.addEventListener("click", () => {
      const files = inputs.flatMap((input) => Array.from(input.files || []));
      if (files.length < 1) {
        window.alert("upload at least 1 transcript before confirming.");
        return;
      }
      confirmField.value = "yes";
      submitBtn.disabled = false;
    });
  })();
</script>
<script src="/js/register.js"></script>
